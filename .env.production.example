# Copy to /var/www/sitedesk/shared/.env on the server, then:
#   php artisan key:generate   (run once inside a release folder)
APP_NAME=SiteDesk
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sitedesk
DB_USERNAME=sitedesk
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Any SMTP provider works (Gmail app password, Brevo, Mailgun, SES...)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

SITEDESK_COMPANY="Sathorn Web Studio"
SITEDESK_PHONE="+66 2 000 0000"
SITEDESK_ADDRESS="Sathorn, Bangkok 10120"
SITEDESK_NOTIFY_EMAIL=owner@example.com

ADMIN_NAME="Site Admin"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
